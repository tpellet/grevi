+            "bad request"
+        );
+        assert_eq!(rejection_message("state too large"), "state too large");
+        assert_eq!(rejection_message(r#"{"error":"x"}"#), r#"{"error":"x"}"#);
+        assert_eq!(rejection_message(""), "");
+        assert_eq!(rejection_message(&"x".repeat(500)).len(), 300);
+    }
+}
