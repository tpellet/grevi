+    assert_eq!(value["data"]["matches"][0]["text"], "invoice\u{fffd}\n");
+    assert_eq!(value["data"]["matches"][0]["lossy"], true);
+    assert_eq!(value["data"]["matches"][0]["ordinal"], 2);
